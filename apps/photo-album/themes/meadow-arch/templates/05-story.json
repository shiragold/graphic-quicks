{
  "format": "photo-album/template@1",
  "id": "meadow-arch/05-story",
  "name": "Story page",
  "role": "page",
  "baseFormat": "a4-portrait",
  "photoCount": {"min": 1, "max": 1},
  "tags": ["story", "paragraph", "title and subtitle", "single photo", "text heavy"],
  "layers": [
    {"type": "background", "fill": "@paper", "asset": "paper-cream"},
    {"id": "arch-shadow", "type": "shape", "shape": "arch", "fill": "@accent2", "opacity": 0.5, "frame": {"x": 150, "y": 135, "w": 400, "h": 580}},
    {"id": "p1", "type": "photo", "importance": 1, "orientation": "portrait", "focus": "faces", "frame": {"x": 115, "y": 100, "w": 400, "h": 580}, "mask": {"shape": "arch"}, "border": {"style": "none", "inset": 14, "insetColor": "@ink"}},
    {"id": "sun", "type": "shape", "shape": "circle", "fill": "@sun", "opacity": 0.9, "frame": {"x": 640, "y": 140, "w": 120, "h": 120}},
    {"id": "title", "type": "text", "role": "title", "bind": "{title}", "style": "display", "size": 76, "minSize": 46, "maxLines": 4, "frame": {"x": 590, "y": 300, "w": 350, "h": 300}, "valign": "top"},
    {"id": "rule", "type": "shape", "shape": "rect", "fill": "@ink", "frame": {"x": 594, "y": 618, "w": 70, "h": 2}},
    {"id": "subtitle", "type": "text", "role": "subtitle", "bind": "{subtitle}", "style": "body", "size": 34, "minSize": 24, "maxLines": 3, "frame": {"x": 592, "y": 635, "w": 350, "h": 125}, "valign": "top"},
    {"id": "date", "type": "text", "role": "date", "bind": "{date:MMMM yyyy}", "style": "label", "size": 22, "frame": {"x": 115, "y": 755, "w": 420, "h": 36}},
    {"id": "story", "type": "text", "role": "body", "bind": "{story}", "style": "body", "override": {"italic": false, "lineHeight": 1.35}, "size": 36, "minSize": 25, "maxLines": 13, "frame": {"x": 115, "y": 815, "w": 770, "h": 430}, "valign": "top", "placeholder": "Tell the story of these days"},
    {"id": "sprig", "type": "asset", "asset": "sprig-olive", "frame": {"x": 690, "y": 1225, "w": 260, "h": 180}, "rotate": -10},
    {"id": "wildflowers", "type": "asset", "asset": "wildflowers", "frame": {"x": 40, "y": 1225, "w": 90, "h": 180}}
  ],
