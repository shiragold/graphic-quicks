    "washi-dots": "assets/washi-dots.svg",
    "tape-masking": "assets/tape-masking.svg",
    "torn-strip": "assets/torn-strip.svg",
    "ticket": "assets/ticket.svg",
    "postmark": "assets/postmark.svg",
    "label-tag": "assets/label-tag.svg",
    "doodle-star": "assets/doodle-star.svg",
    "doodle-heart": "assets/doodle-heart.svg",
    "doodle-arrow": "assets/doodle-arrow.svg",
    "doodle-squiggle": "assets/doodle-squiggle.svg",
    "sparkles": "assets/sparkles.svg",
    "paperclip": "assets/paperclip.svg",
    "sticker-sun": "assets/sticker-sun.svg",
