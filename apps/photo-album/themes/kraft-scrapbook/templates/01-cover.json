{
  "format": "photo-album/template@1",
  "id": "kraft-scrapbook/01-cover",
  "name": "Taped hero cover",
  "role": "cover",
  "baseFormat": "square",
  "photoCount": {"min": 1, "max": 1},
  "tags": ["cover", "hero", "single photo", "landscape"],
  "layers": [
    {"type": "background", "fill": "@paper", "asset": "paper-kraft"},
    {"id": "title", "type": "text", "role": "title", "bind": "{title}", "style": "title", "size": 96, "frame": {"x": 70, "y": 50, "w": 860, "h": 140}, "rotate": -1.5, "align": "center"},
    {"id": "sparkles", "type": "asset", "asset": "sparkles", "frame": {"x": 870, "y": 870, "w": 100, "h": 100}},
    {"id": "p1", "type": "photo", "importance": 1, "orientation": "landscape", "focus": "subject", "frame": {"x": 120, "y": 225, "w": 760, "h": 510}, "rotate": -2, "mask": {"shape": "rect"}, "border": {"style": "mat", "width": 0.035}, "shadow": "lifted"},
    {"id": "washi-stripe", "type": "asset", "asset": "washi-stripe", "attachTo": "p1", "frame": {"x": -70, "y": -10, "w": 230, "h": 54}, "rotate": -38},
    {"id": "washi-dots", "type": "asset", "asset": "washi-dots", "attachTo": "p1", "frame": {"x": 620, "y": -40, "w": 220, "h": 52}, "rotate": 28},
