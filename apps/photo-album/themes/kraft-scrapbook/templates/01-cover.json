    {"id": "place", "type": "text", "role": "caption", "bind": "{place}", "style": "caption", "size": 36, "frame": {"x": 330, "y": 905, "w": 300, "h": 60}, "rotate": -3, "align": "left"},
    {"id": "tag", "type": "asset", "asset": "label-tag", "frame": {"x": 580, "y": 800, "w": 330, "h": 92}, "rotate": 5, "shadow": "soft", "fit": "stretch"},
    {"id": "date", "type": "text", "role": "date", "bind": "{date:MMMM yyyy}", "style": "label", "size": 30, "attachTo": "tag", "frame": {"x": 10, "y": 0, "w": 270, "h": 92}, "align": "center"}
