{
  "name": "@graphic-quicks/photo-filter",
  "version": "0.1.0",
  "description": "Query, preview, and export photos from the macOS Photos library (via osxphotos) as a library, CLI, and MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "photo-filter": "./dist/cli.js",
    "photo-filter-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "jev-eval": "pnpm build && node --env-file-if-exists=.env scripts/jev-eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
