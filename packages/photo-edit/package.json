{
  "name": "@graphic-quicks/photo-edit",
  "version": "0.1.0",
  "description": "Pure OpenCV deskew/crop helpers extracted from graphic-quicks' photo-edit tool.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx tests/generate-fixtures.ts"
  },
  "peerDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1"
  },
  "peerDependenciesMeta": {
    "@techstark/opencv-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
